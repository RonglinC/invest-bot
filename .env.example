# Copy this file to `.env` and fill in your key.
# `.env` is already in .gitignore so it won't be pushed to GitHub.
#
# How to get an OpenAI key:
#   1. Go to https://platform.openai.com/api-keys
#   2. Sign up / log in, then add at least $5 of credit under Billing
#   3. Click "Create new secret key" and paste it below
#
# gpt-4o-mini is cheap: a few hundred chats won't cost you $1.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
